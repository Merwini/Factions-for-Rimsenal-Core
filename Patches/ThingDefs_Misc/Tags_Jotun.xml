<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!--Assault Armor-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Apparel_AssaultArmor"]/apparel/tags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_AssaultArmor"]/apparel/tags</xpath>
			<value>
				<li>JI_ArmorL</li>
				<li>RS_ArmorL</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_AssaultArmor"]/apparel</xpath>
			<value>
				<tags>
					<li>JI_ArmorL</li>
					<li>RS_ArmorL</li>
